<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Portable: runs on Windows (odbc32.dll) and on Linux/macOS (unixODBC). Pick a runtime at publish time with -r.
         64-bit only (checked at startup): SQLLEN/SQLULEN are declared as 8 bytes, and a 64-bit process loads
         the 64-bit Driver Manager and therefore only 64-bit drivers and DSNs. -->
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredCompilation>false</TieredCompilation>
    <AssemblyName>OdbcBench</AssemblyName>
    <RootNamespace>OdbcBench</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OdbcBench.Tests" />
  </ItemGroup>

</Project>
